# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
.env/
*.venv
.venv*/

# ── Secrets / environment files ─────────────────────────────────────────────
.env
.env.*
*.env
!*.env.example

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ── Data files (never commit training data or raw CSVs) ─────────────────────
*.csv
*.tsv
*.parquet
*.jsonl
*.feather
*.pkl
*.pickle
data/

# ── Build / dist ─────────────────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
*.whl

# ── Node / PDF gen tooling ───────────────────────────────────────────────────
pdf-gen/
node_modules/

# ── VS Code workspace settings ───────────────────────────────────────────────
# Commit: settings.json (workspace config for .venv, formatters, etc.)
# Ignore: user-specific settings, logs, and temporary files
.vscode/*.code-workspace
.vscode/launch.json
.vscode/tasks.json
.vscode/*.log
.vscode/.ropeproject
.vscode/settings.local.json

# ── OS artifacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Model weights / checkpoints (often large + proprietary) ─────────────────
*.pt
*.pth
*.safetensors
*.gguf
*.bin
checkpoints/

# Fine-tuned model checkpoints (from experiments)
tinyllama-lora/
tinyllama-pharma-*/
llama-pharma-domain/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
*.err
logs/
runs/

# ── Reports / test output / local caches ─────────────────────────────────────
# Root notebook-audit scratch reports; authored reports elsewhere stay trackable.
/report*.txt
/report*.md
project.lock.json
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
playwright-report/
test-results/

# ── Editor / merge / manual backup residue ───────────────────────────────────
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej
*~

# ── Local server runtime (Ollama / Jupyter / MkDocs) ────────────────────────
.ollama.pid
.jupyter.pid
.mkdocs.pid
.mkdocs-site/

# CCE (code-context-engine)
# CCE local cache (per-machine, not for version control)
.cce/
# Claude Code local settings written by cce init
.claude/settings.local.json
