{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:riverside:ai-engineer:training-example:v1",
  "title": "Riverside AI Engineer training example",
  "description": "Schema for one line of training-examples.jsonl. Semantic checks such as role order, duplicates, PII, and provenance policy are intentionally outside structural validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "example_id",
    "task_type",
    "split",
    "slice",
    "messages",
    "chosen",
    "rejected",
    "comparison_group_id",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "ai-eng.training-example.v1" },
    "example_id": { "type": "string", "pattern": "^td-[0-9]{3}$" },
    "task_type": { "enum": ["sft", "preference"] },
    "split": { "enum": ["train", "validation", "test"] },
    "slice": { "enum": ["rights", "security", "finance", "editorial", "catalog"] },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["system", "user", "assistant"] },
          "content": { "type": "string" }
        }
      }
    },
    "chosen": { "type": ["string", "null"] },
    "rejected": { "type": ["string", "null"] },
    "comparison_group_id": {
      "type": ["string", "null"],
      "pattern": "^cg-[0-9]{3}$"
    },
    "provenance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["source_id", "source_uri", "content_class", "rights_status", "split_policy"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^src-riv-[0-9]{3}$" },
        "source_uri": { "type": "string", "pattern": "^urn:riverside:synthetic:" },
        "content_class": { "enum": ["policy", "manuscript", "annotation"] },
        "rights_status": { "enum": ["synthetic_approved", "unknown"] },
        "split_policy": { "enum": ["train_allowed", "eval_reserved"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "task_type": { "const": "sft" } } },
      "then": {
        "properties": {
          "chosen": { "type": "null" },
          "rejected": { "type": "null" },
          "comparison_group_id": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "task_type": { "const": "preference" } } },
      "then": {
        "properties": {
          "chosen": { "type": "string", "minLength": 1 },
          "rejected": { "type": "string", "minLength": 1 },
          "comparison_group_id": { "type": "string", "pattern": "^cg-[0-9]{3}$" }
        }
      }
    }
  ]
}
