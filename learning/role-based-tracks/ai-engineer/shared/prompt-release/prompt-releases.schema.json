{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:riverside:ai-engineer:prompt-releases:v1",
  "title": "Riverside prompt releases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "releases"],
  "properties": {
    "schema_version": { "const": "ai-eng.prompt-releases.v1" },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt_release_id",
          "status",
          "created_at_utc",
          "prompt_template",
          "tool_schema_version",
          "retrieval_config_id",
          "model_alias",
          "evaluator_version",
          "changed_fields",
          "rollback_target"
        ],
        "properties": {
          "prompt_release_id": { "type": "string", "pattern": "^prompt-riv-[0-9]{3}$" },
          "status": { "enum": ["accepted", "candidate", "rejected"] },
          "created_at_utc": { "type": "string", "format": "date-time" },
          "prompt_template": { "type": "string", "minLength": 1 },
          "tool_schema_version": { "type": "string", "pattern": "^tools-riv-v[0-9]+$" },
          "retrieval_config_id": { "type": "string", "pattern": "^retrieval-riv-[0-9]{3}$" },
          "model_alias": { "type": "string", "pattern": "^model-riv-[a-z0-9-]+$" },
          "evaluator_version": { "type": "string", "pattern": "^evaluator-riv-[0-9]{3}$" },
          "changed_fields": {
            "type": "array",
            "items": { "enum": ["prompt_template", "tool_schema_version", "retrieval_config_id", "model_alias", "evaluator_version"] },
            "uniqueItems": true
          },
          "rollback_target": {
            "type": ["string", "null"],
            "pattern": "^prompt-riv-[0-9]{3}$"
          }
        }
      }
    }
  }
}
