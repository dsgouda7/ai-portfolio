{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:riverside:ai-engineer:paired-eval-case:v1",
  "title": "Riverside paired prompt evaluation case",
  "description": "Schema for one line of paired-eval-cases.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "eval_case_id",
    "slice",
    "query",
    "reference_requirements",
    "baseline_prompt_release_id",
    "candidate_prompt_release_id",
    "baseline_response",
    "candidate_response",
    "baseline_pass",
    "candidate_pass"
  ],
  "properties": {
    "schema_version": { "const": "ai-eng.paired-eval-case.v1" },
    "eval_case_id": { "type": "string", "pattern": "^ec-[0-9]{3}$" },
    "slice": { "enum": ["rights", "finance", "security", "hr", "editorial"] },
    "query": { "type": "string", "minLength": 1 },
    "reference_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "baseline_prompt_release_id": { "const": "prompt-riv-001" },
    "candidate_prompt_release_id": { "const": "prompt-riv-002" },
    "baseline_response": { "type": "string", "minLength": 1 },
    "candidate_response": { "type": "string", "minLength": 1 },
    "baseline_pass": { "type": "boolean" },
    "candidate_pass": { "type": "boolean" }
  }
}
