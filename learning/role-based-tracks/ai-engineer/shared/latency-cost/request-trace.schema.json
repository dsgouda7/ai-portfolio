{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:riverside:ai-engineer:request-trace:v1",
  "title": "Riverside staged request trace",
  "description": "Schema for one line of request-traces.jsonl. Request totals are repeated intentionally so consumers can verify stage attribution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "release_id",
    "started_at_utc",
    "outcome",
    "cache_status",
    "cache_origin_request_id",
    "total_latency_ms",
    "total_cost_microusd",
    "usage",
    "stages"
  ],
  "properties": {
    "schema_version": { "const": "ai-eng.request-trace.v1" },
    "request_id": { "type": "string", "pattern": "^req-[0-9]{3}$" },
    "release_id": { "type": "string", "pattern": "^rel-riv-[0-9]{3}$" },
    "started_at_utc": { "type": "string", "format": "date-time" },
    "outcome": { "enum": ["success", "failed"] },
    "cache_status": { "enum": ["miss", "exact_hit"] },
    "cache_origin_request_id": { "type": ["string", "null"], "pattern": "^req-[0-9]{3}$" },
    "total_latency_ms": { "type": "integer", "minimum": 0 },
    "total_cost_microusd": { "type": "integer", "minimum": 0 },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["billed_input_tokens", "billed_output_tokens", "served_output_tokens"],
      "properties": {
        "billed_input_tokens": { "type": "integer", "minimum": 0 },
        "billed_output_tokens": { "type": "integer", "minimum": 0 },
        "served_output_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_name", "attempt", "status", "latency_ms", "cost_microusd", "input_tokens", "output_tokens", "ttft_ms", "tpot_ms"],
        "properties": {
          "stage_name": { "enum": ["gateway", "cache_lookup", "embedding", "retrieval", "reranking", "generation", "retry_backoff"] },
          "attempt": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["success", "failed", "hit", "miss"] },
          "latency_ms": { "type": "integer", "minimum": 0 },
          "cost_microusd": { "type": "integer", "minimum": 0 },
          "input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "ttft_ms": { "type": ["integer", "null"], "minimum": 0 },
          "tpot_ms": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    }
  }
}
