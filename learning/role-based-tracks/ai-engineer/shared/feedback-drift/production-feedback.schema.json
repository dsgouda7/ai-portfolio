{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:riverside:ai-engineer:production-feedback:v1",
  "title": "Riverside production feedback trace",
  "description": "Schema for one line of production-feedback.jsonl. Query summaries are synthetic and contain no raw user text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feedback_trace_id",
    "request_id",
    "observed_at_utc",
    "window",
    "release_id",
    "slice",
    "query_summary",
    "retrieval_hit",
    "quality_pass",
    "latency_ms",
    "cost_microusd",
    "expected_policy_outcome",
    "actual_policy_outcome",
    "user_feedback",
    "failure_codes",
    "review_status",
    "review_label",
    "candidate_eval_case_id"
  ],
  "properties": {
    "schema_version": { "const": "ai-eng.production-feedback.v1" },
    "feedback_trace_id": { "type": "string", "pattern": "^fb-[0-9]{3}$" },
    "request_id": { "type": "string", "pattern": "^prod-req-[0-9]{3}$" },
    "observed_at_utc": { "type": "string", "format": "date-time" },
    "window": { "enum": ["baseline", "current"] },
    "release_id": { "type": "string", "pattern": "^rel-riv-[0-9]{3}$" },
    "slice": { "enum": ["rights", "hr", "finance", "security"] },
    "query_summary": { "type": "string", "minLength": 1 },
    "retrieval_hit": { "type": "boolean" },
    "quality_pass": { "type": "boolean" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "cost_microusd": { "type": "integer", "minimum": 0 },
    "expected_policy_outcome": { "enum": ["allow", "block"] },
    "actual_policy_outcome": { "enum": ["allow", "block"] },
    "user_feedback": { "enum": ["up", "down", "none"] },
    "failure_codes": {
      "type": "array",
      "items": { "enum": ["retrieval_miss", "quality_failure", "latency_slo_breach", "policy_false_allow"] },
      "uniqueItems": true
    },
    "review_status": { "enum": ["not_sampled", "reviewed"] },
    "review_label": { "type": ["string", "null"], "enum": [null, "acceptable", "retrieval_failure", "policy_failure"] },
    "candidate_eval_case_id": { "type": ["string", "null"], "pattern": "^evalcand-[0-9]{3}$" }
  }
}
