      "secret": false
    },
    {
      "name": "riverside-max-input-tokens",
      "source": "MODEL_MAX_INPUT_TOKENS",
      "example": "8192",
      "secret": false
    },
    {
      "name": "riverside-max-output-tokens",
      "source": "MODEL_MAX_OUTPUT_TOKENS",
      "example": "2048",
      "secret": false
    },
    {
      "name": "riverside-standard-tpm",
      "source": "APIM_STANDARD_TPM",
      "example": "20000",
      "secret": false
    },
    {
      "name": "riverside-premium-tpm",
      "source": "APIM_PREMIUM_TPM",
      "example": "60000",
      "secret": false
    },
    {
      "name": "riverside-internal-tpm",
      "source": "APIM_INTERNAL_TPM",
      "example": "100000",
      "secret": false
    },
    {
      "name": "riverside-max-retries",
      "source": "APIM_MAX_RETRIES",
