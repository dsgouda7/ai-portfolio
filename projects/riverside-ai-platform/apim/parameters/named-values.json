      "secret": false
    },
    {
      "name": "riverside-backend-timeout-seconds",
      "source": "APIM_BACKEND_TIMEOUT_SECONDS",
      "example": "30",
      "secret": false
    },
    {
      "name": "riverside-max-retry-after-seconds",
      "source": "APIM_MAX_RETRY_AFTER_SECONDS",
      "example": "30",
      "secret": false
    },
    {
      "name": "riverside-content-safety-enabled",
      "source": "APIM_CONTENT_SAFETY_ENABLED",
      "example": "false",
      "secret": false
    },
    {
      "name": "riverside-content-safety-backend-id",
      "source": "APIM_CONTENT_SAFETY_BACKEND_ID",
      "secret": false
    },
    {
      "name": "riverside-semantic-cache-enabled",
      "source": "APIM_SEMANTIC_CACHE_ENABLED",
      "example": "false",
      "secret": false
    },
    {
      "name": "riverside-embeddings-backend-id",
