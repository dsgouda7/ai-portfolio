{
  "contract_version": "1.0.0",
  "description": "Deployment contract for APIM named values. Values come from environment configuration or IaC parameters; this file contains no credentials or live endpoints.",
  "named_values": [
    {
      "name": "riverside-environment",
      "source": "environment",
      "allowed_values": [
        "dev",
        "staging",
        "production"
      ],
      "secret": false
    },
    {
      "name": "riverside-entra-tenant-id",
      "source": "ENTRA_TENANT_ID",
      "secret": false
    },
    {
      "name": "riverside-entra-client-application-id",
      "source": "ENTRA_CLIENT_APPLICATION_ID",
      "secret": false
    },
    {
      "name": "riverside-entra-api-audience",
      "source": "ENTRA_API_AUDIENCE",
      "secret": false
    },
    {
      "name": "riverside-entra-required-scope",
      "source": "ENTRA_REQUIRED_SCOPE",
      "secret": false
    },
    {
      "name": "riverside-backend-pool-id",
      "source": "APIM_BACKEND_POOL_ID",
      "secret": false
    },
    {
      "name": "riverside-backend-audience",
      "source": "RIVERSIDE_BACKEND_AUDIENCE",
      "secret": false
    },
    {
      "name": "riverside-request-schema-id",
