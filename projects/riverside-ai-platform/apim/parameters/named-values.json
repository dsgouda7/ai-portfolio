    {
      "name": "riverside-semantic-cache-ttl-seconds",
      "source": "APIM_SEMANTIC_CACHE_TTL_SECONDS",
      "example": "300",
      "secret": false
    },
    {
      "name": "riverside-model-release-id",
      "source": "RIVERSIDE_MODEL_RELEASE_ID",
      "secret": false
    },
    {
      "name": "riverside-deployment-name",
      "source": "RIVERSIDE_DEPLOYMENT_NAME",
      "secret": false
    }
  ]
}
