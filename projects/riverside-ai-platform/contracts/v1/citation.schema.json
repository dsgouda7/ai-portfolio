{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.riverside.example/contracts/v1/citation.schema.json",
  "title": "Riverside Citation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "kind",
    "citation_id",
    "chunk_id",
    "document_id",
    "source_uri",
    "source_version",
    "content_hash",
    "title",
    "answer_spans",
    "retrieved_at"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/contractVersion"
    },
    "kind": {
      "const": "citation"
    },
    "citation_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "chunk_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "document_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "source_uri": {
      "$ref": "common.schema.json#/$defs/uri"
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "content_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "answer_spans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "retrieved_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
