{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.riverside.example/contracts/v1/app-chat-completion-response.schema.json",
  "title": "Riverside OpenAI-Compatible Chat Completion Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "object",
    "created",
    "model",
    "choices",
    "usage",
    "citations",
    "trace",
    "deployment"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^chatcmpl-[A-Za-z0-9_-]{8,64}$"
    },
    "object": {
      "const": "chat.completion"
    },
    "created": {
      "type": "integer",
      "minimum": 0
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "message",
          "finish_reason"
        ],
        "properties": {
          "index": {
            "const": 0
          },
          "message": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "const": "assistant"
              },
              "content": {
                "type": "string",
                "maxLength": 131072
              },
              "refusal": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2048
              }
            }
          },
          "finish_reason": {
            "type": "string",
            "enum": [
              "stop",
              "length",
              "content_filter",
              "error"
            ]
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_tokens",
        "completion_tokens",
        "total_tokens"
      ],
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10240
        }
      }
    },
    "citations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "citation.schema.json"
      }
    },
    "trace": {
      "$ref": "common.schema.json#/$defs/traceMetadata"
    },
    "deployment": {
      "$ref": "deployment-metadata.schema.json"
    }
  }
}
