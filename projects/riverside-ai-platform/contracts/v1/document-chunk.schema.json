{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.riverside.example/contracts/v1/document-chunk.schema.json",
  "title": "Riverside Document Chunk v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "kind",
    "tenant_id",
    "chunk_id",
    "document_id",
    "parent_document_id",
    "source_uri",
    "source_version",
    "content_hash",
    "document_content_hash",
    "acl",
    "region",
    "classification",
    "ingested_at",
    "pipeline_version",
    "deletion_state",
    "ordinal",
    "offsets",
    "chunking",
    "embedding",
    "index_version",
    "content"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/contractVersion"
    },
    "kind": {
      "const": "document_chunk"
    },
    "tenant_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "chunk_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "document_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "parent_document_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "source_uri": {
      "$ref": "common.schema.json#/$defs/uri"
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "content_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "document_content_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "acl": {
      "$ref": "common.schema.json#/$defs/acl"
    },
    "region": {
      "$ref": "common.schema.json#/$defs/region"
    },
    "classification": {
      "$ref": "common.schema.json#/$defs/classification"
    },
    "ingested_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "pipeline_version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "deletion_state": {
      "$ref": "common.schema.json#/$defs/deletionState"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "offsets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "start",
        "end"
      ],
      "properties": {
        "unit": {
          "const": "unicode_code_points"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "chunking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "version"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9-]+$"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/semanticVersion"
        }
      }
    },
    "embedding": {
      "$ref": "common.schema.json#/$defs/embeddingDescriptor"
    },
    "index_version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    }
  }
}
