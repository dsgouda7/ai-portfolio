{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.riverside.example/contracts/v1/app-chat-completion-request.schema.json",
  "title": "Riverside OpenAI-Compatible Chat Completion Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "messages",
    "max_input_tokens",
    "max_tokens",
    "stream"
  ],
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      }
    },
    "max_input_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "default": 0.1
    },
    "top_p": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "default": 1
    },
    "stream": {
      "type": "boolean"
    },
    "stop": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      ]
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "top_k"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "search_type": {
          "type": "string",
          "enum": [
            "similarity",
            "mmr",
            "hybrid"
          ]
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "classification": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/classification"
              }
            },
            "source_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "region": {
              "$ref": "common.schema.json#/$defs/region"
            }
          }
        }
      }
    }
  }
}
