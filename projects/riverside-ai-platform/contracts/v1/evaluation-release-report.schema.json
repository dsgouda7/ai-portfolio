{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.riverside.example/contracts/v1/evaluation-release-report.schema.json",
  "title": "Riverside Evaluation Release Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "kind",
    "report_id",
    "release_id",
    "release_version",
    "generated_at",
    "source_commit",
    "decision",
    "decision_reasons",
    "evidence",
    "domains"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/contractVersion"
    },
    "kind": {
      "const": "evaluation_release_report"
    },
    "report_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "release_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "release_version": {
      "$ref": "common.schema.json#/$defs/semanticVersion"
    },
    "baseline_release_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "source_commit": {
      "$ref": "common.schema.json#/$defs/sourceCommit"
    },
    "decision": {
      "type": "string",
      "enum": [
        "promote",
        "hold",
        "reject"
      ]
    },
    "decision_reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "uri",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uri": {
            "$ref": "common.schema.json#/$defs/uri"
          },
          "digest": {
            "$ref": "common.schema.json#/$defs/digest"
          }
        }
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_quality",
        "retrieval_quality",
        "generation_citation_quality",
        "adaptation_evidence",
        "safety_authorization",
        "operational_slos",
        "cost",
        "rollout_comparison"
      ],
      "properties": {
        "data_quality": {
          "$ref": "#/$defs/metricSet"
        },
        "retrieval_quality": {
          "$ref": "#/$defs/metricSet"
        },
        "generation_citation_quality": {
          "$ref": "#/$defs/metricSet"
        },
        "adaptation_evidence": {
          "$ref": "#/$defs/metricSet"
        },
        "safety_authorization": {
          "$ref": "#/$defs/metricSet"
        },
        "operational_slos": {
          "$ref": "#/$defs/metricSet"
        },
        "cost": {
          "$ref": "#/$defs/metricSet"
        },
        "rollout_comparison": {
          "$ref": "#/$defs/metricSet"
        }
      }
    }
  },
  "$defs": {
    "metricSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "dataset",
        "evaluator",
        "slice",
        "threshold",
        "observed",
        "status"
      ],
      "properties": {
        "metric_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            "version": {
              "$ref": "common.schema.json#/$defs/semanticVersion"
            }
          }
        },
        "slice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "value"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "value",
            "unit"
          ],
          "properties": {
            "operator": {
              "type": "string",
              "enum": [
                "lt",
                "lte",
                "gt",
                "gte",
                "eq"
              ]
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "lower",
            "upper",
            "confidence_level",
            "sample_size"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "lower": {
              "type": "number"
            },
            "upper": {
              "type": "number"
            },
            "confidence_level": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "sample_size": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    }
  }
}
