# Select a non-default config file when needed.
RAG_CONFIG_PATH=config.yaml

# Databricks identity and remote ingestion governance.
# Authenticate with Azure CLI, workload identity, or managed identity; do not store tokens here.
DATABRICKS_HOST=
RIVERSIDE_INGEST_SOURCE_URI=
RIVERSIDE_INGEST_TENANT_ID=
RIVERSIDE_INGEST_REGION=
RIVERSIDE_INGEST_CLASSIFICATION=

# Azure ML or APIM managed-identity selection.
AZURE_CLIENT_ID=

# Optional bearer token for a non-Azure OpenAI-compatible local endpoint.
# Reference this variable by name with serving.generation.endpoint.bearer_token_env_var.
LOCAL_LLM_BEARER_TOKEN=

# Optional legacy Watsonx credential. Used only when provider=watsonx_legacy.
WATSONX_APIKEY=
