# ── Provider selection ─────────────────────────────────────────────────────────
# LLM_PROVIDER: "ollama" (default) | "azure"
LLM_PROVIDER=ollama

# STT_PROVIDER: "local" (default, faster-whisper) | "azure"
STT_PROVIDER=local

# TTS_PROVIDER: "local" (default, edge-tts) | "azure"
TTS_PROVIDER=local

# ── Ollama (local LLM) ─────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_LLM_MODEL=mistral

# faster-whisper settings
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8   # int8 (CPU default) | float16 (GPU)

# edge-tts default voice (used when caller sends "" or "default")
# Full list: https://gist.github.com/BettyJJ/17cbaa1de96235a7f5773b8690a20462
DEFAULT_LOCAL_VOICE=en-US-AriaNeural

# ── Azure AI Foundry (cloud LLM) ───────────────────────────────────────────────
# Required when LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=<your-key>
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Azure Cognitive Services Speech (cloud STT + TTS) ─────────────────────────
# Required when STT_PROVIDER=azure or TTS_PROVIDER=azure
# AZURE_SPEECH_KEY=<your-key>
# AZURE_SPEECH_REGION=eastus
# DEFAULT_AZURE_VOICE=en-US-AriaNeural
