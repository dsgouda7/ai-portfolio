# deployments/local/.env.example
# Copy to .env and fill in. Gitignored when filled.
#
# Controls which Ollama models the local deployment uses.
# All services reach Ollama at OLLAMA_BASE_URL (host machine).

# ── LLM provider ─────────────────────────────────────────────────────────
COMPRESSOR_PROVIDER=ollama

# Model used by the ingestion service to compress corpus chunks.
# Smaller = faster ingestion. llama3.2:3b is a good default.
COMPRESSOR_MODEL=llama3.2:3b

# Model used by the reasoning gateway for multi-branch ToT reasoning.
# Can be the same model or a larger one if you have VRAM to spare.
REASONING_MODEL=llama3.2:3b

# Base URL for the Ollama HTTP API.
# Docker Desktop (Windows/macOS): host.docker.internal resolves to the host.
# Linux Docker Engine: use 172.17.0.1 or enable extra_hosts in docker-compose.yml.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Embedding ─────────────────────────────────────────────────────────────
# Local CPU model — runs inside the embedding container, no host dependency.
EMBEDDING_MODEL=all-MiniLM-L6-v2
