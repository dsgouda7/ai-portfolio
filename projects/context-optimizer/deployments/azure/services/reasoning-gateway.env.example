# reasoning-gateway.env.example
# Main app container — LiteLLM router connecting to the Azure reasoning LLM.
# This file is generated at startup by keyvault/fetch-secrets.sh.
# Secret source → Azure Key Vault secret name shown in comments.

# KV secret: co-reasoning-api-key
AZURE_API_KEY=

# KV secret: co-reasoning-endpoint
AZURE_API_BASE=https://<resource>.openai.azure.com/

AZURE_API_VERSION=2024-02-01

# KV secret: co-reasoning-deployment  (e.g. gpt-4.1-mini)
AZURE_DEPLOYMENT_NAME=

CONTEXT_OPTIMIZER_COMPRESSOR_PROVIDER=azure
VECTOR_STORE_URL=http://vector-store:8003
DEFAULT_COLLECTION=default
