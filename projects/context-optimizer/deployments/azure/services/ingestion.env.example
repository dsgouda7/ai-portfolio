# ingestion.env.example
# Ingestion service — uses a lighter Azure OpenAI deployment for corpus compression.
# This file is generated at startup by keyvault/fetch-secrets.sh.

# KV secret: co-summarizer-api-key
AZURE_API_KEY=

# KV secret: co-summarizer-endpoint
AZURE_API_BASE=https://<resource>.openai.azure.com/

AZURE_API_VERSION=2024-02-01

# KV secret: co-summarizer-deployment  (e.g. gpt-4o-mini)
AZURE_DEPLOYMENT_NAME=

CONTEXT_OPTIMIZER_COMPRESSOR_PROVIDER=azure
EMBEDDING_SERVICE_URL=http://embedding:8002
VECTOR_STORE_URL=http://vector-store:8003
