# Context Optimizer AI Gateway - Environment Configuration

# ============================================================================
# LLM Provider API Keys
# ============================================================================

# OpenAI (GPT-4, GPT-3.5)
OPENAI_API_KEY=sk-your-key-here

# Anthropic (Claude 3)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Groq (Fast inference)
GROQ_API_KEY=gsk_your-key-here

# Azure OpenAI (Optional)
AZURE_API_KEY=your-azure-key
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-02-15-preview

# AWS Bedrock (Optional)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1

# ============================================================================
# Local LLM (Ollama)
# ============================================================================

OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# Cache Configuration
# ============================================================================

# Redis cache
REDIS_URL=redis://localhost:6379

# Cache TTL (seconds)
CACHE_TTL=3600

# ============================================================================
# Compression Settings
# ============================================================================

# Token threshold for compression (default: 2000)
COMPRESSION_THRESHOLD=2000

# Target compression ratio (default: 0.02 = 2%)
TARGET_COMPRESSION_RATIO=0.02

# ============================================================================
# Gateway Configuration
# ============================================================================

# Service port
PORT=8080

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable cost tracking
TRACK_COSTS=true

# ============================================================================
# Security (Production)
# ============================================================================

# API key validation (comma-separated)
VALID_API_KEYS=key1,key2,key3

# Rate limit (requests per minute)
RATE_LIMIT_RPM=60

# CORS origins (comma-separated)
CORS_ORIGINS=*

# ============================================================================
# Monitoring (Optional)
# ============================================================================

# Prometheus metrics
PROMETHEUS_PORT=9090

# Datadog API key
DATADOG_API_KEY=

# Sentry DSN
SENTRY_DSN=
