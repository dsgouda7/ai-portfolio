# embedding.env.example
# Embedding service — Azure AI text-embedding-3-small (~10 ms cloud PoP latency).
# This file is generated at startup by keyvault/fetch-secrets.sh.
# To use local CPU embeddings instead, set EMBEDDING_BACKEND=local (no KV secrets needed).

EMBEDDING_BACKEND=azure

# KV secret: co-embedding-api-key
AZURE_EMBEDDING_API_KEY=

# KV secret: co-embedding-endpoint
AZURE_EMBEDDING_ENDPOINT=https://<resource>.openai.azure.com/

# KV secret: co-embedding-model  (e.g. text-embedding-3-small)
AZURE_EMBEDDING_MODEL=

AZURE_EMBEDDING_API_VERSION=2024-02-01
