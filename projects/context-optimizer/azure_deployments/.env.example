# Azure identity for the secrets-init container.
# Copy this file to .env.azure, fill in your values, and NEVER commit it.
#
# The secrets-init container uses these to authenticate to Azure Key Vault
# and writes per-service .env files under azure_deployments/services/.
#
# Auth options (pick one):
#   Option A — Service principal (CI/CD or Docker Desktop)
#   Option B — Remove client ID/secret lines and use `az login` beforehand
#              (the Azure CLI image will use the cached token).

# ── Azure identity ────────────────────────────────────────────────────────
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<your-service-principal-app-id>
AZURE_CLIENT_SECRET=<your-service-principal-secret>

# ── Key Vault ─────────────────────────────────────────────────────────────
# URI of the vault created by keyvault/provision.sh
AZURE_KEYVAULT_URI=https://<your-keyvault-name>.vault.azure.net/

# ── Secret names (defaults match provision.sh — change only if you renamed) ─
KV_SECRET_REASONING_API_KEY=co-reasoning-api-key
KV_SECRET_REASONING_ENDPOINT=co-reasoning-endpoint
KV_SECRET_REASONING_DEPLOYMENT=co-reasoning-deployment
KV_SECRET_SUMMARIZER_API_KEY=co-summarizer-api-key
KV_SECRET_SUMMARIZER_ENDPOINT=co-summarizer-endpoint
KV_SECRET_SUMMARIZER_DEPLOYMENT=co-summarizer-deployment
KV_SECRET_EMBEDDING_API_KEY=co-embedding-api-key
KV_SECRET_EMBEDDING_ENDPOINT=co-embedding-endpoint
KV_SECRET_EMBEDDING_MODEL=co-embedding-model
